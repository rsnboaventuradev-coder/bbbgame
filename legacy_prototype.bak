import React, { useState, useEffect, useRef } from 'react';
import {
    Users, Heart, Battery, Zap, MessageCircle, Eye,
    AlertTriangle, Trophy, Activity, UserPlus, Moon,
    Vote, Target, Shield, Crown, Skull, Home, Ear, Sparkles,
    Dumbbell, BookOpen, Trash2
} from 'lucide-react';

const App = () => {
    // --- Estados do Jogo ---
    const [gameState, setGameState] = useState('menu'); // menu, playing, minigame, voting_house, voting_results, eliminated, winner
    const [day, setDay] = useState(1);
    const [player, setPlayer] = useState({
        name: 'Você',
        archetype: '',
        popularity: 50,
        energy: 100,
        stress: 0,
        immunity: false,
        romanceId: null,
        boredomCount: 0,
    });

    const [npcs, setNpcs] = useState([]);
    const [feed, setFeed] = useState([]);
    const [logs, setLogs] = useState([]);
    const [leaderId, setLeaderId] = useState(null);
    const [selectedTarget, setSelectedTarget] = useState(null);
    const [nominees, setNominees] = useState([]);
    const [houseCleanliness, setHouseCleanliness] = useState(100); // 0 (Lixão) a 100 (Brilhando)

    // --- Estados do Minigame ---
    const [minigameState, setMinigameState] = useState({
        active: false, score: 0, targetScore: 0, timeLeft: 5, isPlaying: false
    });

    const logsEndRef = useRef(null);

    // --- Banco de Dados Procedural ---
    const names = ["Enzo", "Valentina", "Cleber", "Jurema", "Thales", "Bia", "Rodrigão", "Luana", "Fábio", "Mirella"];
    const jobs = ["Modelo", "Professor(a)", "Influencer", "Médico(a)", "Advogado(a)", "DJ", "Personal Trainer"];
    const traits = [
        { id: 'barraqueiro', name: 'Barraqueiro', desc: 'Gera entretenimento, mas cria inimigos.' },
        { id: 'planta', name: 'Planta', desc: 'Foge do jogo, público tende a esquecer.' },
        { id: 'estrategista', name: 'Estrategista', desc: 'Joga com a mente, perigoso no paredão.' },
        { id: 'sedutor', name: 'Sedutor', desc: 'Foca em romances e alianças duplas.' }
    ];

    // --- Constantes de Estilo ---
    const actionBtnClass = "rounded-lg flex flex-col items-center justify-center gap-1 p-2 transition-all active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed disabled:active:scale-100 h-16 shadow-lg border border-white/5 relative overflow-hidden";

    // --- Inicialização ---
    const generateNPCs = (count) => {
        let newNpcs = [];
        let usedNames = new Set();

        for (let i = 0; i < count; i++) {
            let name = names[Math.floor(Math.random() * names.length)];
            while (usedNames.has(name)) {
                name = names[Math.floor(Math.random() * names.length)];
            }
            usedNames.add(name);

            const job = jobs[Math.floor(Math.random() * jobs.length)];
            const trait = traits[Math.floor(Math.random() * traits.length)];

            newNpcs.push({
                id: i + 1,
                name,
                job,
                trait,
                affinity: 50,
                publicPop: 40 + Math.floor(Math.random() * 40),
                status: 'active',
                votesReceived: 0
            });
        }
        return newNpcs;
    };

    const handleStart = (archetype) => {
        const generatedNpcs = generateNPCs(6);
        setNpcs(generatedNpcs);
        setPlayer({
            ...player,
            archetype: archetype.name,
            popularity: archetype.bonus.popularity,
            energy: archetype.bonus.energy,
            stress: 0,
            immunity: false,
            romanceId: null,
            boredomCount: 0
        });
        setHouseCleanliness(100);
        setGameState('playing');
        setDay(1);
        setLogs([]);
        setFeed([]);
        setLeaderId(null);
        addLog(`Bem-vindo à casa! Seus concorrentes são: ${generatedNpcs.map(n => n.name).join(', ')}.`, 'system');
        addSocialPost('neutral');
    };

    // --- Sistema de Logs e Feed ---
    const scrollToBottom = () => logsEndRef.current?.scrollIntoView({ behavior: "smooth" });
    useEffect(() => scrollToBottom(), [feed, logs]);

    const addLog = (text, type = 'info') => setLogs(prev => [...prev, { text, type, id: Date.now() + Math.random() }]);

    const addSocialPost = (sentiment, context = "") => {
        const reactions = {
            good: ["Joga y Joga!", "Protagonista!", "Essa atitude foi tudo 😍", `#Team${player.name}`, "Muitos pontos com o público!"],
            bad: ["Que vergonha...", "FORA!", "Não aguento mais essa pessoa", "Muito falso(a)", "Cancelado(a)!"],
            neutral: ["Interessante...", "O clima pesou hein", "Essa casa tá pegando fogo"],
            drama: ["MEU DEUS A TRETA", "Pegou a pipoca?", "Eitaaa 🔥", "O puro suco do entretenimento"],
            planta: ["Alguém avisa que ele(a) tá no programa?", "Samambaia total 🌿", "Só dorme, que tédio...", "Zero conteúdo #Planta"]
        };

        let pool = reactions.neutral;
        if (sentiment === 'positive') pool = reactions.good;
        if (sentiment === 'negative') pool = reactions.bad;
        if (sentiment === 'drama') pool = reactions.drama;
        if (sentiment === 'planta') pool = reactions.planta;

        const randomComment = pool[Math.floor(Math.random() * pool.length)];
        const randomUser = `@user${Math.floor(Math.random() * 9000) + 1000}`;
        setFeed(prev => [{ user: randomUser, text: `${randomComment} ${context}`, id: Date.now() }, ...prev].slice(0, 5));
    };

    // --- Lógica de Ações ---
    const executeAction = (actionType) => {
        if (player.energy <= 10 && actionType !== 'sleep') {
            addLog("Você está exausto! Precisa dormir.", 'alert');
            return;
        }

        if (['socialize', 'conflict', 'romance', 'eavesdrop'].includes(actionType) && !selectedTarget) {
            addLog("Selecione um participante clicando no card dele primeiro!", 'alert');
            return;
        }

        let targetNPC = selectedTarget ? npcs.find(n => n.id === selectedTarget) : null;
        if (targetNPC && targetNPC.status === 'eliminated') {
            addLog("Essa pessoa já foi eliminada.", 'alert');
            return;
        }

        let p = { ...player };
        let sentiment = 'neutral';
        let activityLevel = 'low';

        switch (actionType) {
            case 'gym': // Academia
                p.energy -= 25;
                p.stress = Math.max(0, p.stress - 25);
                p.popularity += 2; // Imagem saudável
                addLog("Você treinou pesado na academia. O estresse diminuiu!");
                activityLevel = 'medium';
                sentiment = 'positive';
                break;

            case 'read': // Ler Livro
                p.energy -= 10;
                p.stress = Math.max(0, p.stress - 15);
                addLog("Você se isolou para ler um livro e relaxar a mente.");
                activityLevel = 'low'; // Risco de planta se abusar
                break;

            case 'housework': // Cozinhar/Limpar
                setNpcs(prev => prev.map(n => ({ ...n, affinity: Math.min(100, n.affinity + 3) })));
                setHouseCleanliness(prev => Math.min(100, prev + 40));
                p.energy -= 20;
                p.stress = Math.max(0, p.stress - 5); // Satisfação de limpar
                p.popularity += 2;
                addLog("Você limpou a casa e cozinhou. O ambiente ficou melhor!");
                sentiment = 'positive';
                activityLevel = 'medium';
                break;

            case 'eavesdrop':
                p.energy -= 15;
                // Risco alto de estresse se falhar
                const success = Math.random() > 0.4;
                if (success) {
                    const secretTarget = targetNPC || npcs[Math.floor(Math.random() * npcs.length)];
                    const secret = secretTarget.affinity < 40 ? `desconfia de você` : `está planejando votos`;
                    addLog(`Psiu! Você ouviu: ${secretTarget.name} ${secret}.`);
                    activityLevel = 'medium';
                } else {
                    addLog(`Ops! Você foi pego ouvindo atrás da porta. Que mico!`, 'alert');
                    p.popularity -= 5;
                    p.stress += 15; // Estresse por ser pego
                    if (targetNPC) updateAffinity(targetNPC.id, -10);
                    sentiment = 'bad';
                    activityLevel = 'medium';
                }
                break;

            case 'romance':
                if (targetNPC.affinity < 75) {
                    addLog(`${targetNPC.name} não tem intimidade suficiente. (Requer 75% Afinidade)`, 'alert');
                    return;
                }
                p.energy -= 20;
                p.romanceId = targetNPC.id;
                p.popularity += 10;
                p.stress = Math.max(0, p.stress - 10); // Amor acalma
                updateAffinity(targetNPC.id, 15);
                addLog(`O clima esquentou com ${targetNPC.name}. O público shippa! ❤️`);
                sentiment = 'positive';
                activityLevel = 'high';
                break;

            case 'socialize':
                if (targetNPC) {
                    const bonus = targetNPC.trait.id === 'amigo' ? 15 : 10;
                    updateAffinity(targetNPC.id, bonus);
                    p.energy -= 15;
                    p.stress = Math.max(0, p.stress - 5);
                    addLog(`Papo agradável com ${targetNPC.name}.`);
                    sentiment = 'neutral';
                    activityLevel = 'medium';
                }
                break;

            case 'conflict':
                if (targetNPC) {
                    updateAffinity(targetNPC.id, -30);
                    p.popularity += (Math.random() > 0.5 ? 10 : -5);
                    p.energy -= 25;
                    p.stress += 25; // Brigar estressa muito
                    addLog(`TRETA! Discussão feia com ${targetNPC.name}!`, 'alert');
                    sentiment = 'drama';
                    activityLevel = 'high';
                    setNpcs(prev => prev.map(n => {
                        if (n.id === targetNPC.id) return n;
                        if (n.trait.id === 'planta') return { ...n, affinity: n.affinity - 5 };
                        return n;
                    }));
                }
                break;

            case 'strategy': // Observar/Estrategia (reutilizando a lógica anterior)
                p.energy -= 10;
                p.stress += 5; // Pensar demais estressa
                const randomNpc = npcs[Math.floor(Math.random() * npcs.length)];
                addLog(`Análise: ${randomNpc.name} tem ${randomNpc.publicPop}% de aprovação externa.`);
                sentiment = 'neutral';
                activityLevel = 'low';
                break;

            case 'sleep':
                p.energy = 100;
                p.stress = Math.max(0, p.stress - 15);
                addLog("Você dormiu o resto do dia.");
                activityLevel = 'low';
                break;

            default: break;
        }

        if (activityLevel === 'low') {
            p.boredomCount += 1;
        } else if (activityLevel === 'high') {
            p.boredomCount = 0;
        }

        // Limites
        p.popularity = Math.min(100, Math.max(0, p.popularity));
        p.stress = Math.min(100, Math.max(0, p.stress));
        setPlayer(p);
        if (actionType !== 'sleep') addSocialPost(sentiment);
        setSelectedTarget(null);
    };

    const updateAffinity = (npcId, amount) => {
        setNpcs(prev => prev.map(npc => {
            if (npc.id === npcId) {
                return { ...npc, affinity: Math.min(100, Math.max(0, npc.affinity + amount)) };
            }
            return npc;
        }));
    };

    // --- Ciclo do Jogo ---
    const nextDay = () => {
        const activeNpcs = npcs.filter(n => n.status === 'active');
        if (activeNpcs.length <= 2) {
            setGameState('winner');
            return;
        }

        setDay(prev => prev + 1);

        // Decaimento da Limpeza
        const dirtyFactor = 15;
        const newCleanliness = Math.max(0, houseCleanliness - dirtyFactor);
        setHouseCleanliness(newCleanliness);

        // Efeitos do Dia
        let stressMod = 0;
        if (newCleanliness < 30) {
            stressMod += 15;
            addLog("A casa está imunda! O cheiro e a bagunça estão te estressando.", 'alert');
        }

        if (player.boredomCount >= 2) {
            setPlayer(prev => ({ ...prev, popularity: Math.max(0, prev.popularity - 5) }));
            addLog("CUIDADO: Você está muito quieto (Planta). Público rejeita!", 'alert');
            addSocialPost('planta');
        }

        // Eventos de Ciclo
        if ((day + 1) % 4 === 0) {
            startVotingPhase();
        } else if ((day + 1) % 4 === 1) {
            addLog(`Dia ${day + 1}: PROVA DO LÍDER!`, 'system');
            startMinigame();
        } else {
            const evts = ["Festa hoje a noite!", "Manutenção externa.", "Dia de Cinema.", "Punição coletiva: sem água quente."];
            const evt = evts[Math.floor(Math.random() * evts.length)];
            addLog(`Dia ${day + 1}: ${evt}`, 'system');

            setPlayer(prev => ({ ...prev, stress: Math.min(100, Math.max(0, prev.stress + stressMod + 5)) }));

            setNpcs(prev => prev.map(n => ({
                ...n,
                publicPop: Math.min(100, Math.max(0, n.publicPop + (Math.random() > 0.5 ? 5 : -5)))
            })));
        }
    };

    const startMinigame = () => {
        setGameState('minigame');
        setMinigameState({ active: true, score: 0, targetScore: 8 + Math.floor(day / 3), timeLeft: 8, isPlaying: true });
    };

    useEffect(() => {
        let timer;
        if (gameState === 'minigame' && minigameState.isPlaying) {
            timer = setInterval(() => {
                setMinigameState(prev => {
                    if (prev.timeLeft <= 1) {
                        endMinigame(prev.score);
                        return { ...prev, timeLeft: 0, isPlaying: false };
                    }
                    return { ...prev, timeLeft: prev.timeLeft - 1 };
                });
            }, 1000);
        }
        return () => clearInterval(timer);
    }, [gameState, minigameState.isPlaying]);

    const handleMinigameClick = () => setMinigameState(prev => ({ ...prev, score: prev.score + 1 }));

    const endMinigame = (finalScore) => {
        const target = minigameState.targetScore;
        if (finalScore >= target) {
            addLog(`LÍDER! Você venceu a prova.`, 'system');
            setPlayer(prev => ({ ...prev, immunity: true, popularity: prev.popularity + 5, stress: Math.max(0, prev.stress - 10) }));
            setLeaderId('player');
            addSocialPost('positive', 'O LÍDER DA SEMANA!');
        } else {
            const activeNpcs = npcs.filter(n => n.status === 'active');
            const winner = activeNpcs[Math.floor(Math.random() * activeNpcs.length)];
            setLeaderId(winner.id);
            setPlayer(prev => ({ ...prev, immunity: false }));
            addLog(`${winner.name} é o novo Líder.`, 'alert');
        }
        setTimeout(() => setGameState('playing'), 2000);
    };

    const startVotingPhase = () => {
        addLog("🚨 PAREDÃO: A casa deve votar para indicar 3 pessoas.", 'alert');
        setGameState('voting_house');
        setNpcs(prev => prev.map(n => ({ ...n, votesReceived: 0 })));
    };

    const castHouseVote = (targetId) => {
        let currentNpcs = [...npcs];

        // Voto do Player
        const targetIdx = currentNpcs.findIndex(n => n.id === targetId);
        currentNpcs[targetIdx].votesReceived += 1;
        addLog(`Você votou em ${currentNpcs[targetIdx].name}.`);

        // Votos dos NPCs
        let playerVotes = 0;
        currentNpcs.forEach(voter => {
            if (voter.status !== 'active') return;
            const hateForPlayer = 100 - voter.affinity;
            if (leaderId !== 'player' && !player.immunity && Math.random() * 100 < hateForPlayer) {
                playerVotes++;
            } else {
                const validTargets = currentNpcs.filter(n => n.id !== voter.id && n.status === 'active');
                const randomTarget = validTargets[Math.floor(Math.random() * validTargets.length)];
                if (randomTarget) randomTarget.votesReceived += 1;
            }
        });

        // Definir Emparedados
        let allCandidates = [];
        if (!player.immunity && leaderId !== 'player') {
            allCandidates.push({ id: 'player', name: player.name, votes: playerVotes, type: 'player', pop: player.popularity });
        }
        currentNpcs.filter(n => n.status === 'active' && leaderId !== n.id).forEach(n => {
            allCandidates.push({ id: n.id, name: n.name, votes: n.votesReceived, type: 'npc', pop: n.publicPop });
        });

        allCandidates.sort((a, b) => b.votes - a.votes);
        const top3 = allCandidates.slice(0, 3);

        // Estresse do Paredão
        if (top3.some(c => c.id === 'player')) {
            setPlayer(prev => ({ ...prev, stress: Math.min(100, prev.stress + 30) }));
            addLog("VOCÊ ESTÁ NO PAREDÃO! Seu estresse disparou!", 'alert');
        }

        setNominees(top3);
        setGameState('voting_results');
    };

    const resolvePublicElimination = () => {
        let eliminatedCandidate = null;
        let minScore = 999;

        nominees.forEach(cand => {
            let effectivePop = cand.pop + (Math.random() * 10 - 5);
            if (cand.type === 'player' && player.boredomCount > 1) effectivePop -= 20;
            if (effectivePop < minScore) {
                minScore = effectivePop;
                eliminatedCandidate = cand;
            }
        });

        if (eliminatedCandidate.id === 'player') {
            setGameState('eliminated');
        } else {
            const elimName = eliminatedCandidate.name;
            addLog(`🔥 ELIMINADO: ${elimName} saiu com rejeição!`, 'alert');
            addSocialPost('drama', `Tchau ${elimName}!`);

            setNpcs(prev => prev.map(n =>
                n.id === eliminatedCandidate.id ? { ...n, status: 'eliminated' } : n
            ));

            if (nominees.some(n => n.id === 'player') && eliminatedCandidate.id !== 'player') {
                setPlayer(p => ({ ...p, popularity: p.popularity + 10 }));
                addLog("Você voltou do Paredão! O público gostou da sua permanência.", 'system');
            }

            setTimeout(() => setGameState('playing'), 3000);
        }
    };

    // --- Renderização ---

    if (gameState === 'menu') {
        const archetypes = [
            { id: 'strategist', name: 'O Estrategista', bonus: { popularity: 40, energy: 100 } },
            { id: 'charismatic', name: 'O Carismático', bonus: { popularity: 70, energy: 90 } },
            { id: 'villain', name: 'O Vilão', bonus: { popularity: 30, energy: 110 } }
        ];
        return (
            <div className= "min-h-screen bg-gray-900 text-white p-6 flex flex-col items-center justify-center font-sans" >
            <h1 className="text-4xl md:text-5xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-600 mb-8 text-center" >
                BIG REALITY BRASIL
                    </h1>
                    < div className = "grid grid-cols-1 md:grid-cols-3 gap-4 max-w-4xl w-full" >
                    {
                        archetypes.map(arc => (
                            <button key= { arc.id } onClick = {() => handleStart(arc)} className = "bg-gray-800 hover:bg-gray-700 p-8 rounded-xl border border-gray-700 hover:border-purple-500 transition-all transform hover:-translate-y-1" >
                                <h3 className="text-2xl font-bold mb-2" > { arc.name } </h3>
                                    < p className = "text-gray-400" > Clique para entrar </p>
                                        </button>
          ))}
</div>
    </div>
    );
  }

if (gameState === 'eliminated' || gameState === 'winner') {
    return (
        <div className= "min-h-screen bg-gray-900 text-white flex flex-col items-center justify-center p-6 text-center" >
            { gameState === 'winner' ? <Trophy size={ 80 } className = "text-yellow-400 mb-4" /> : <Skull size={ 80 } className = "text-red-500 mb-4" />}
<h2 className="text-4xl font-bold mb-4" > { gameState === 'winner' ? 'VOCÊ VENCEU O PROGRAMA!' : 'ELIMINADO PELO PÚBLICO!'}</h2>
    < p className = "text-xl text-gray-400 mb-8" > { gameState === 'eliminated' ? 'O público achou que você não agregava mais ao jogo.' : 'O Brasil te ama!'}</p>
        < button onClick = {() => setGameState('menu')} className = "bg-purple-600 px-8 py-3 rounded-full font-bold hover:bg-purple-700" > Novo Jogo </button>
            </div>
    );
  }

if (gameState === 'minigame') {
    return (
        <div className= "min-h-screen bg-gray-900 text-white flex flex-col items-center justify-center p-6" >
        <h2 className="text-3xl font-bold mb-2 text-yellow-400 animate-pulse" > PROVA DO LÍDER </h2>
            < div className = "text-6xl font-mono mb-8 font-bold" > { minigameState.timeLeft }s </div>
                < div className = "text-2xl mb-8" > Cliques: { minigameState.score } / {minigameState.targetScore}</div >
                    <button onMouseDown={ handleMinigameClick } className = "w-48 h-48 rounded-full bg-blue-600 hover:bg-blue-500 active:bg-blue-400 shadow-[0_0_50px_rgba(37,99,235,0.6)] flex items-center justify-center text-2xl font-bold transition-all transform active:scale-95 select-none cursor-pointer border-4 border-blue-400" > CLIQUE RÁPIDO! </button>
                        </div>
    );
}

if (gameState === 'voting_house') {
    return (
        <div className= "min-h-screen bg-gray-900 text-white p-6 flex flex-col items-center" >
        <h2 className="text-3xl font-bold mb-4 text-red-500 flex items-center gap-2" > <Vote/> VOTAÇÃO DA CASA</h2 >
            <div className="grid grid-cols-2 md:grid-cols-3 gap-4 max-w-4xl w-full" >
            {
                npcs.filter(n => n.status === 'active').map(npc => (
                    <button 
              key= { npc.id } 
              onClick = {() => castHouseVote(npc.id)}
    disabled = { leaderId === npc.id
}
className = "bg-gray-800 hover:bg-red-900/40 border border-gray-700 hover:border-red-500 p-4 rounded-xl flex items-center gap-4 transition-all disabled:opacity-50 disabled:cursor-not-allowed"
    >
    <div className="w-12 h-12 bg-gray-700 rounded-full flex items-center justify-center font-bold text-lg" > { npc.name[0] } </div>
        < div className = "text-left" >
            <div className="font-bold text-lg" > { npc.name } </div>
{ leaderId === npc.id && <span className="text-xs text-yellow-400 font-bold" > LÍDER(Imune) </span> }
</div>
    </button>
          ))}
</div>
    </div>
    );
  }

if (gameState === 'voting_results') {
    return (
        <div className= "min-h-screen bg-gray-900 text-white p-6 flex flex-col items-center justify-center" >
        <h2 className="text-3xl font-bold mb-8 text-yellow-500" > PAREDÃO FORMADO </h2>
            < div className = "flex flex-col md:flex-row gap-6 mb-12" >
            {
                nominees.map((nom, idx) => (
                    <div key= { idx } className = "bg-gray-800 border-2 border-red-500 p-6 rounded-xl flex flex-col items-center w-48 animate-bounce-slow" >
                    <div className="w-20 h-20 bg-gray-700 rounded-full mb-4 flex items-center justify-center text-3xl font-bold" >
                    { nom.name[0] }
                    </div>
                < h3 className = "font-bold text-xl" > { nom.name } </h3>
                < p className = "text-red-400 text-sm mt-2" > { nom.votes } votos da casa </p>
                </div>
                ))
            }
                </div>
                < button onClick = { resolvePublicElimination } className = "bg-red-600 hover:bg-red-700 text-white font-bold py-3 px-10 rounded-full text-lg shadow-lg shadow-red-900/50 transition-all hover:scale-105" >
                    VER ELIMINAÇÃO
                        </button>
                        </div>
      );
}

// --- HUD Principal ---
return (
    <div className= "min-h-screen bg-gray-950 text-white font-sans flex flex-col md:flex-row overflow-hidden" >

    {/* Sidebar Jogador */ }
    < div className = "w-full md:w-64 bg-gray-900 p-4 border-r border-gray-800 flex flex-col gap-4" >
        <div className="flex items-center gap-3 mb-2" >
            <div className="w-12 h-12 bg-purple-600 rounded-full flex items-center justify-center font-bold text-xl relative border-2 border-purple-400 shadow-lg shadow-purple-900/50" >
                { player.name[0] }
{ player.immunity && <Shield className="absolute -top-2 -right-2 text-yellow-400 w-6 h-6 bg-gray-900 rounded-full p-1" />}
{ leaderId === 'player' && <Crown className="absolute -bottom-2 -right-2 text-yellow-400 w-6 h-6 bg-gray-900 rounded-full p-1" />}
</div>
    < div >
    <h3 className="font-bold" > { player.name } </h3>
        < p className = "text-xs text-gray-400" > { player.archetype } </p>
            </div>
            </div>

            < div className = "space-y-4 text-sm bg-gray-800/50 p-3 rounded-xl" >
                <div>
                <div className="flex justify-between mb-1" > <span className="text-gray-400 flex items-center gap-1" > <Heart size={ 12 } /> Popularidade</span > <span className={ player.popularity < 40 ? 'text-red-400' : 'text-green-400' }> { Math.round(player.popularity) } % </span></div >
                    <div className="h-1.5 bg-gray-700 rounded-full" > <div className={ `h-full rounded-full transition-all ${player.popularity < 40 ? 'bg-red-500' : 'bg-green-500'}` } style = {{ width: `${player.popularity}%` }}/></div >
                        </div>
                        < div >
                        <div className="flex justify-between mb-1" > <span className="text-gray-400 flex items-center gap-1" > <Battery size={ 12 } /> Energia</span > <span>{ player.energy } % </span></div >
                            <div className="h-1.5 bg-gray-700 rounded-full" > <div className="h-full bg-yellow-400 rounded-full" style = {{ width: `${player.energy}%` }}/></div >
                                </div>
                                < div >
                                <div className="flex justify-between mb-1" > <span className="text-gray-400 flex items-center gap-1" > <Activity size={ 12 } /> Estresse</span > <span className={ player.stress > 70 ? 'text-red-400 font-bold' : 'text-blue-300' }> { player.stress } % </span></div >
                                    <div className="h-1.5 bg-gray-700 rounded-full" > <div className={ `h-full rounded-full transition-all ${player.stress > 70 ? 'bg-red-600' : 'bg-blue-500'}` } style = {{ width: `${player.stress}%` }}/></div >
                                        </div>
                                        < div >
                                        <div className="flex justify-between mb-1" > <span className="text-gray-400 flex items-center gap-1" > <Sparkles size={ 12 } /> Limpeza Casa</span > <span className={ houseCleanliness < 30 ? 'text-red-400' : 'text-emerald-400' }> { houseCleanliness } % </span></div >
                                            <div className="h-1.5 bg-gray-700 rounded-full" > <div className={ `h-full rounded-full transition-all ${houseCleanliness < 30 ? 'bg-red-500' : 'bg-emerald-500'}` } style = {{ width: `${houseCleanliness}%` }}/></div >
                                                </div>
                                                </div>

{
    player.romanceId && (
        <div className="bg-pink-900/30 border border-pink-700/50 p-3 rounded-lg flex items-center gap-2" >
            <Heart className="text-pink-500" size = { 16} fill = "currentColor" />
                <div className="text-xs" >
                    <span className="block text-pink-200 font-bold" > Romance Ativo </span>
                        </div>
                        </div>
        )
}

<div className="mt-auto pt-4 border-t border-gray-800" >
    <button onClick={ nextDay } className = "w-full bg-indigo-900 hover:bg-indigo-800 py-3 rounded-lg flex items-center justify-center gap-2 transition-colors border border-indigo-700 shadow-lg" >
        <Moon size={ 16 }/> Encerrar Dia {day}
            </button>
            </div>
            </div>

{/* Área Principal */ }
<div className="flex-1 flex flex-col p-4 relative overflow-hidden bg-gradient-to-br from-gray-900 to-gray-950" >
    {/* NPCs */ }
    < div className = "flex flex-wrap gap-3 mb-4 justify-center md:justify-start" >
    {
        npcs.map(npc => (
            <div 
                    key= { npc.id }
                    onClick = {() => npc.status === 'active' && setSelectedTarget(npc.id === selectedTarget ? null : npc.id)}
className = {`
                        relative w-24 p-2 rounded-lg border cursor-pointer transition-all flex flex-col items-center
                        ${npc.status === 'eliminated' ? 'opacity-40 grayscale bg-gray-900 border-gray-800' : 'bg-gray-800 hover:bg-gray-700'}
                        ${selectedTarget === npc.id ? 'border-blue-500 ring-2 ring-blue-500/50 transform scale-105 shadow-blue-900/50 shadow-lg' : 'border-gray-700'}
                        ${leaderId === npc.id ? 'border-yellow-500/50' : ''}
                    `}
                >
    <div className="w-10 h-10 bg-gray-700 rounded-full mb-2 flex items-center justify-center font-bold text-sm text-gray-300 relative" >
        { npc.name[0] }
{ leaderId === npc.id && <Crown className="absolute -top-3 -right-2 text-yellow-400 w-5 h-5 drop-shadow-md" fill = "currentColor" />}
{ player.romanceId === npc.id && <Heart className="absolute -bottom-1 -right-1 text-pink-500 w-4 h-4" fill = "currentColor" />}
</div>
    < div className = "font-bold text-xs truncate w-full text-center" > { npc.name } </div>
        < div className = "text-[9px] text-gray-400 truncate w-full text-center" > { npc.trait.name } </div>
{
    npc.status === 'active' && (
        <div className="mt-1 w-full h-1 bg-gray-900 rounded-full overflow-hidden" >
            <div className={ `h-full ${npc.affinity > 75 ? 'bg-pink-500' : npc.affinity > 40 ? 'bg-blue-500' : 'bg-red-500'}` } style = {{ width: `${npc.affinity}%` }
}/>
    </div>
                    )}
{ npc.status === 'eliminated' && <div className="absolute inset-0 flex items-center justify-center bg-black/60 rounded-lg text-[10px] font-bold text-red-500 uppercase rotate-12 border-2 border-red-500/50" > Eliminado </div> }
</div>
            ))}
</div>

{/* Logs */ }
<div className="flex-1 overflow-y-auto mb-4 bg-black/20 rounded-xl p-4 border border-gray-800 space-y-2 text-sm shadow-inner backdrop-blur-sm custom-scrollbar" >
    { logs.length === 0 && <p className="text-gray-500 text-center italic mt-10"> O jogo começou.Interaja para não virar planta!</ p >}
{
    logs.map(log => (
        <div key= { log.id } className = {`p-2 rounded border-l-2 animate-fadeIn ${log.type === 'alert' ? 'border-red-500 bg-red-900/10 text-red-200' :
                log.type === 'system' ? 'border-blue-500 bg-blue-900/10 text-blue-200' :
                    'border-gray-600 bg-gray-800/40 text-gray-300'
            }`}>
                { log.text }
                </div>
            ))}
<div ref={ logsEndRef } />
    </div>

{/* Action Bar */ }
<div className="grid grid-cols-3 md:grid-cols-4 lg:grid-cols-7 gap-2 pb-2" >
    <button disabled={ player.energy < 20 } onClick = {() => executeAction('housework')} className = {`${actionBtnClass} bg-emerald-700 hover:bg-emerald-600`}>
        <Home size={ 18 } /> <span className="text-xs font-bold">Limpar</span >
            </button>
            < button disabled = { player.energy < 25 } onClick = {() => executeAction('gym')} className = {`${actionBtnClass} bg-orange-700 hover:bg-orange-600`}>
                <Dumbbell size={ 18 } /> <span className="text-xs font-bold">Academia</span >
                    </button>
                    < button disabled = { player.energy < 10 } onClick = {() => executeAction('read')} className = {`${actionBtnClass} bg-teal-700 hover:bg-teal-600`}>
                        <BookOpen size={ 18 } /> <span className="text-xs font-bold">Ler</span >
                            </button>
                            < button disabled = {!selectedTarget || player.energy < 15} onClick = {() => executeAction('socialize')} className = {`${actionBtnClass} bg-blue-700 hover:bg-blue-600`}>
                                <MessageCircle size={ 18 } /> <span className="text-xs font-bold">Social</span >
                                    </button>
                                    < button disabled = {!selectedTarget || player.energy < 25} onClick = {() => executeAction('conflict')} className = {`${actionBtnClass} bg-red-700 hover:bg-red-600`}>
                                        <Zap size={ 18 } /> <span className="text-xs font-bold">Treta</span >
                                            </button>
                                            < button disabled = {!selectedTarget || player.energy < 20} onClick = {() => executeAction('romance')} className = {`${actionBtnClass} ${(!selectedTarget || npcs.find(n => n.id === selectedTarget)?.affinity < 75) ? 'bg-gray-700 opacity-50' : 'bg-pink-600 hover:bg-pink-500'}`}>
                                                <Heart size={ 18 } fill = { selectedTarget && npcs.find(n => n.id === selectedTarget)?.affinity >= 75 ? "currentColor" : "none"}/> <span className="text-xs font-bold">Romance</span >
                                                    </button>
                                                    < button disabled = { player.energy < 15 } onClick = {() => executeAction('eavesdrop')} className = {`${actionBtnClass} bg-purple-700 hover:bg-purple-600`}>
                                                        <Ear size={ 18 } /> <span className="text-xs font-bold">Espionar</span >
                                                            </button>
                                                            </div>
                                                            < div className = "flex justify-center md:justify-end mt-2" >
                                                                <button onClick={ () => executeAction('sleep') } className = "w-full md:w-auto px-6 py-2 bg-gray-700 hover:bg-gray-600 rounded-lg flex items-center justify-center gap-2 transition-colors text-xs font-bold uppercase tracking-wide" >
                                                                    <Battery size={ 16 }/> Dormir
                                                                        </button>
                                                                        </div>

{ !selectedTarget && <div className="absolute bottom-24 right-4 md:right-10 text-yellow-400 text-xs font-bold animate-pulse pointer-events-none drop-shadow-md hidden md:block" > Selecione um NPC para Social / Treta / Romance </div> }
</div>

{/* Feed Social */ }
<div className="w-full md:w-64 bg-gray-900 border-l border-gray-800 flex flex-col hidden md:flex" >
    <div className="p-3 border-b border-gray-800 font-bold text-sm text-gray-400 flex items-center gap-2 bg-gray-900/90 backdrop-blur sticky top-0" >
        <MessageCircle size={ 16 }/> REDES SOCIAIS
            </div>
            < div className = "flex-1 overflow-y-auto p-3 space-y-3 bg-gray-900" >
            {
                feed.map(post => (
                    <div key= { post.id } className = "bg-gray-800 p-3 rounded-lg text-xs border border-gray-700 shadow-sm" >
                    <div className="font-bold text-blue-400 mb-1 flex items-center gap-1" >
                    { post.user } < span className = "text-[8px] bg-blue-900 text-blue-200 px-1 rounded" > fã </span>
                    </div>
                    < div className = "text-gray-200" > { post.text } </div>
                    </div>
                ))
            }
                </div>
                </div>

                < style > {`
        .custom-scrollbar::-webkit-scrollbar {
          width: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
          background: rgba(0,0,0,0.1);
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
          background: rgba(255,255,255,0.1);
          border-radius: 10px;
        }
      `}</style>
    </div>
  );
};

export default App;
